NOTE boot hooks={"sm":"function","rw":"function","af":"function"}
NOTE ========== A 组：渲染态结构与编辑回写 ==========
PASS A1 两个 li 均 plaintext-only 且带 data-line inf={"n": 2, "ce": ["plaintext-only", "plaintext-only"], "lines": ["0", "1"]}
PASS A2 渲染为单个 ul（无多余 pre/代码块） ul=1 ol=0 pre=0
PASS A3 列表块非源码态（渲染态可直编） cls=blk b-list
FAIL A4 含行内格式列表项编辑 → 标记保留（LIST-2 回归） raw=["- **粗体追加**项"]
PASS A5 有序列表渲染为 ol 且编号自 1 起 inf=["甲", "乙", "丙"]
PASS A6 有序列表保留原始起始编号（start 属性） start=3
NOTE ========== B 组：回车（新增 / 拆分 / 空项退出） ==========
PASS B1 行尾回车 → 插入同级新项（marker 一致） raw=["- 甲项\n- \n- 乙项"]
FAIL B2 行中回车 → 后半文字移入新项（Typora 式拆分） raw=["- 甲乙\n- "]
PASS B3 空项回车 → 退出列表：列表保留 + 其后新建空段落 raw=["- 甲项", ""]
PASS B4 退出落点不是源码态（QUO-8 同型校验：无字面 - 泄漏） cls=blk b-list ae=DIV:null
PASS B5 连续两次回车（非空块后）→ 列表未被拍平、文档块数 +1 raw=["- 甲项", "", "尾段"]
PASS B6 有序列表回车 → 新项编号 +1 且后续顺延 raw=["1. 甲\n2. \n3. 乙"]
NOTE ========== C 组：退格（合并 / 转段落 / 删空项） ==========
PASS C1 第 2 项行首退格 → 合并进上一项 raw=["- 甲项乙项"]
PASS C2 仅一项行首退格 → 转段落（去掉 marker） raw=["甲项"]
PASS C3 空项行首退格 → 仅删该行（列表保留） raw=["- 甲项\n- 乙项"]
NOTE ========== D 组：Tab / Shift+Tab 缩进 ==========
PASS D1 第 2 项 Tab → 缩进 4 空格 raw=["- 甲项\n    - 乙项"]
PASS D2 缩进后渲染为嵌套子列表（ul 内嵌 ul） ul=2 txt=["甲项乙项", "乙项"]
NOTE   D3 首项 Tab → raw=["    - 甲项\n- 乙项"] pre=0
PASS D3 首项 Tab 不产生代码块（缩进不触发源码泄漏） raw=["    - 甲项\n- 乙项"] pre=0
PASS D4 Shift+Tab → 剥除一级缩进 raw=["- 甲项\n- 乙项"]
NOTE ========== E 组：退出方式全路径 ==========
FAIL E1 首项行首 ↑ → 跳出到上一块（列表内容不变） ae=DIV:null raw=["前段", "- 甲项\n- 乙项", "尾段"]
PASS E2 末项行尾 ↓ → 跳出到下一块 ae=DIV:null
PASS E3 Esc → 内容不变（不清空、不转段落） before=["- 甲项\n- 乙项"] after=["- 甲项\n- 乙项"]
NOTE   E3 Esc 后 activeElement=BODY:null / 焦点是否仍在 li：False
PASS E4 点击列表外区域 → 列表保持渲染态且 raw 不变 raw=["- 甲项\n- 乙项", "尾段"] cls=blk b-list
NOTE ========== F 组：内容类型（延续行 / 行内格式 / 嵌套） ==========
NOTE   F1 lazy 延续行：li 数=1 data-line=["0"] txt=["第一行\n第二行\n第三行"]
PASS F1 延续行（无 marker 的后续行）不产生独立可编辑 li n=1 lines=["0"]
NOTE   F1b 在延续行文本后输入 → raw=["- 第一行\n第二行\n第三行X\n第二行\n第三行X\n第二行\n第三行"]
PASS F2 嵌套子列表渲染为嵌套结构且各层可编辑 n=4 ul=2 lines=["0", "1", "2", "3"]
PASS F3 子项编辑回写保留缩进与 marker raw=["- 甲项\n  - 子项甲改\n  - 子项乙\n- 乙项"]
PASS F4 第 2 项加粗 → 标记落在选中项内（LIST-1 跨行回归） raw=["- 甲项\n- **乙项**"]
NOTE ========== G 组：待办列表（checkbox） ==========
PASS G1 待办渲染为 checkbox 且未勾选 cb=2 on=[false, false]
PASS G2 点击 checkbox → raw 变 [x] 且渲染勾选 raw=["- [x] 待办甲\n- [ ] 待办乙"] on=[true, false]
PASS G3 待办项文字编辑 → [x] 状态保留 raw=["- [x] 待办甲补\n- [ ] 待办乙"]
PASS G4 待办项回车 → 新项继承 [ ] 标记 raw=["- [x] 待办甲补\n- [ ] 待办乙\n- [ ] "]

========== 汇总：31 断言，FAIL 3 ==========
  ABN A4 含行内格式列表项编辑 → 标记保留（LIST-2 回归） || raw=["- **粗体追加**项"]
  ABN B2 行中回车 → 后半文字移入新项（Typora 式拆分） || raw=["- 甲乙\n- "]
  ABN E1 首项行首 ↑ → 跳出到上一块（列表内容不变） || ae=DIV:null raw=["前段", "- 甲项\n- 乙项", "尾段"]