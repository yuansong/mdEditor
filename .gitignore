# ---- 构建产物（PyInstaller，可由 build_exe.ps1 重新生成）----
build*/
spec*/
dist*/

# ---- 版本发布包（各约 218MB，单独归档，不入库）----
mdEditor-v*.zip

# ---- 运行 / 测试临时输出（tests 下的 .py 全部保留，.txt 均为运行结果）----
tests/_*.txt
_*.txt
_*.js

# ---- Python ----
__pycache__/
*.pyc

# ---- Qt / PySide6 运行期生成 ----
*.pyproj
*.sln

# ---- WorkBuddy 会话数据（项目笔记 / 日志，非源码）----
.workbuddy/

# ---- 编辑器版本历史目录（若在项目内打开过文档）----
.mdeditor-history/

# ---- 补丁脚本 / 临时备份（一次性产物，不入库）----
_patch_*.py
_bak_*
_TO_DELETE/
tmp_mmd/
_tpl_js.json

# ---- 追加（2026-10-25 发布清理）：临时探针 / 诊断 / 构建副产品 ----
# 测试目录下的临时探针与诊断脚本（真实测试基建 _runner.py / _run_full.py / _syntax_check.py 已跟踪，不受影响）
tests/_*
tests/shots/
tests/*.old*
tests/*_run.txt
# 构建 / 调试临时文件
*.log
dist*.sha256
tmp_ab/
nul
yb_*
_tmp_diag/
build_exe1[0-9][0-9].ps1
_ssh_run.py
_sshlib.py
ribbon_buttons_demo.py
verify_*.py
verify_*.txt
verify_tmp.py
